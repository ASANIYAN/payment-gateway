# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/payment_gateway

# Bank API
BANK_API_URL=http://localhost:8787
BANK_API_TIMEOUT=10000
BANK_API_MAX_RETRIES=3

# Application
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Jobs
COMPLETER_INTERVAL_MS=120000
REAPER_INTERVAL_MS=3600000
STUCK_PAYMENT_THRESHOLD_MS=300000
CLEANUP_AGE_HOURS=72